{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Night",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#1A1816",
					"name": "Base"
				},
				{
					"slug": "base-2",
					"color": "#26221F",
					"name": "Base 2"
				},
				{
					"slug": "contrast",
					"color": "#F2EBDF",
					"name": "Contrast"
				},
				{
					"slug": "contrast-2",
					"color": "#B5ACA0",
					"name": "Contrast 2"
				},
				{
					"slug": "accent",
					"color": "#E7845E",
					"name": "Accent"
				},
				{
					"slug": "accent-2",
					"color": "#9DAE92",
					"name": "Accent 2"
				},
				{
					"slug": "accent-3",
					"color": "#DEA95C",
					"name": "Accent 3"
				}
			],
			"duotone": [
				{
					"slug": "ink-and-paper",
					"colors": [
						"#1A1816",
						"#F2EBDF"
					],
					"name": "Ink and paper"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"css": "&:not(.is-style-dots) { opacity: 0.28; border-bottom-width: 1px; }"
			}
		}
	}
}
