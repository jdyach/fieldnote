{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "color": "#F6F1E8", "name": "Base" },
				{ "slug": "base-2", "color": "#ECE3D4", "name": "Base 2" },
				{ "slug": "contrast", "color": "#1E1B18", "name": "Contrast" },
				{ "slug": "contrast-2", "color": "#5A534C", "name": "Contrast 2" },
				{ "slug": "accent", "color": "#A8451F", "name": "Accent" },
				{ "slug": "accent-2", "color": "#5E6B57", "name": "Accent 2" },
				{ "slug": "accent-3", "color": "#DEA95C", "name": "Accent 3" }
			],
			"gradients": [
				{
					"slug": "paper-fade",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--base) 0%, var(--wp--preset--color--base-2) 100%)",
					"name": "Paper fade"
				},
				{
					"slug": "sunset",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--accent-3) 0%, var(--wp--preset--color--accent) 100%)",
					"name": "Sunset"
				}
			],
			"duotone": [
				{
					"slug": "ink-and-paper",
					"colors": [ "#1E1B18", "#F6F1E8" ],
					"name": "Ink and paper"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "XS" },
				{ "slug": "30", "size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)", "name": "S" },
				{ "slug": "40", "size": "clamp(1.125rem, 0.9rem + 0.9vw, 1.5rem)", "name": "M" },
				{ "slug": "50", "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem)", "name": "L" },
				{ "slug": "60", "size": "clamp(2rem, 1.2rem + 3.2vw, 4rem)", "name": "XL" },
				{ "slug": "70", "size": "clamp(3rem, 1.8rem + 4.8vw, 6rem)", "name": "2XL" },
				{ "slug": "80", "size": "clamp(4rem, 2.4rem + 6.4vw, 8rem)", "name": "3XL" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "shadow": "0 1px 2px rgb(30 27 24 / 6%), 0 8px 24px -8px rgb(30 27 24 / 18%)", "name": "Soft" },
				{ "slug": "offset", "shadow": "6px 6px 0 0 var(--wp--preset--color--contrast)", "name": "Offset" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/Inter-Variable.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/Inter-Variable-Italic.woff2" ]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", ui-serif, Georgia, Cambria, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces/Fraunces-Variable.woff2" ]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces/Fraunces-Variable-Italic.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "fluid": false, "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" }, "name": "Medium" },
				{ "slug": "large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" }, "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "Extra Large" },
				{ "slug": "xx-large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" }, "name": "2X Large" },
				{ "slug": "display", "size": "4.75rem", "fluid": { "min": "2.75rem", "max": "4.75rem" }, "name": "Display" }
			]
		},
		"custom": {
			"radius": {
				"small": "6px",
				"medium": "14px",
				"large": "28px",
				"pill": "999px"
			},
			"transition": "180ms cubic-bezier(0.2, 0, 0, 1)"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			},
			"core/pullquote": {
				"border": { "color": true, "radius": true, "style": true, "width": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "-0.005em"
		},
		"css": "::selection { background: var(--wp--preset--color--accent-3); color: var(--wp--preset--color--contrast); } :where(.wp-site-blocks *:focus-visible) { outline: 2px solid var(--wp--preset--color--accent); outline-offset: 3px; } a { text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: color var(--wp--custom--transition); } .wp-site-blocks > footer.wp-block-template-part { margin-block-start: 0; }",
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.3" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "letterSpacing": "0" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600", "letterSpacing": "0.08em", "textTransform": "uppercase" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--pill)" },
				"spacing": {
					"padding": {
						"top": "0.8em",
						"bottom": "0.8em",
						"left": "1.5em",
						"right": "1.5em"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" },
				"css": "& img { border-radius: inherit; }"
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "3px" }
				},
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--large)", "fontStyle": "italic", "lineHeight": "1.45" },
				"elements": {
					"cite": {
						"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontStyle": "normal", "fontWeight": "600" }
					}
				}
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--x-large)", "fontStyle": "italic", "lineHeight": "1.3" },
				"border": {
					"top": { "color": "var(--wp--preset--color--contrast)", "style": "solid", "width": "1px" },
					"bottom": { "color": "var(--wp--preset--color--contrast)", "style": "solid", "width": "1px" }
				}
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--base-2)" },
				"border": { "radius": "var(--wp--custom--radius--small)" },
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--40)", "bottom": "var(--wp--preset--spacing--40)", "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"css": "&:not(.is-style-dots) { opacity: 0.18; border-bottom-width: 1px; }"
			},
			"core/search": {
				"border": { "radius": "var(--wp--custom--radius--pill)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"css": "& .wp-block-search__input { border-radius: var(--wp--custom--radius--pill); padding-inline: 1em; border-color: color-mix(in srgb, currentColor 30%, transparent); background: transparent; color: inherit; }"
			},
			"core/query-pagination": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/comment-author-name": {
				"typography": { "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "post-meta", "title": "Post Meta", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing Page (no title)", "postTypes": [ "page" ] },
		{ "name": "single-wide", "title": "Wide Post", "postTypes": [ "post" ] }
	]
}
