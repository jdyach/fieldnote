{
	"name": "jdyach/fieldnote",
	"description": "A warm, editorial WordPress block theme built with theme.json, templates and patterns.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"authors": [
		{ "name": "Jacqui Dyach", "homepage": "https://jacquid.com" }
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
