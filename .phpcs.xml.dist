<?xml version="1.0"?>
<ruleset name="Fieldnote">
	<description>WordPress Coding Standards for the Fieldnote block theme.</description>

	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress">
		<!-- Pattern files are mostly block markup with small PHP islands. -->
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<exclude name="Generic.WhiteSpace.ScopeIndent"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fieldnote"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fieldnote"/>
			</property>
		</properties>
	</rule>
</ruleset>
